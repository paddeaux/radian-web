   "source": [
    "import geopandas as gpd\n",
    "import pandas as pd\n",
    "\n",
    "mock = pd.read_csv('mockaroo.csv')[['lat','lon']]\n",
    "gdf = gpd.GeoDataFrame(geometry=gpd.points_from_xy(mock.lon, mock.lat))\n",
    "\n",
    "gdf.to_file('mockaroo_spatial.geojson', driver='GeoJSON')\n",
    "print(gdf)"
   ]
  }
